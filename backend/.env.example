# Environment Variables Template for Zaiqo Backend
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/zaiqo?retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Swiggy Instamart Official MCP Integration (Swiggy Builders Club)
# Portal: https://mcp.swiggy.com/builders/
# Manifest: https://github.com/Swiggy/swiggy-mcp-server-manifest
# Required for live pricing:
SWIGGY_INSTAMART_MCP_URL=https://mcp.swiggy.com/im
SWIGGY_INSTAMART_BEARER_TOKEN=your_swiggy_mcp_bearer_token_here

# Optional delivery address context (for location-specific inventory):
SWIGGY_INSTAMART_ADDRESS_ID=your_delivery_address_id_here

# Optional OAuth placeholders (not currently used; token is obtained via Swiggy Builders Club OAuth portal):
# SWIGGY_INSTAMART_CLIENT_ID=your_swiggy_client_id_here
# SWIGGY_INSTAMART_CLIENT_SECRET=your_swiggy_client_secret_here

